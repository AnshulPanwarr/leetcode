class Solution {
    public int prefixCount(String[] words, String pref) {
        int res = 0;

        for (String word : words) {
            if (word.length() < pref.length()) continue; 

            boolean matches = true;
            for (int i = 0; i < pref.length(); i++) {
                if (pref.charAt(i) != word.charAt(i)) {
                    matches = false;
                    break;
                }
            }

            if (matches) res++;
        }

        return res;
    }
}
